# LifeOS Enterprise — Environment Configuration
# Copie para .env e preencha os valores reais.
# NUNCA comite .env no version control.
# NUNCA compartilhe .env com credenciais reais.

# ═══ Core ═══════════════════════════════════════════════════════════════════
LIFEOS_ENV=production
LOG_LEVEL=INFO
LIFEOS_ENV_PORT=3000

# ═══ Security ═══════════════════════════════════════════════════════════════
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_32_byte_hex_key_here
LIFEOS_SESSION_SECRET=your_random_256bit_secret
LIFEOS_WEBHOOK_SECRET=your_webhook_secret_here

# ═══ Admin ══════════════════════════════════════════════════════════════════
LIFEOS_ADMIN_EMAIL=your_admin_email
LIFEOS_ADMIN_PASSWORD_HASH=your_sha256_hash_here
LIFEOS_ADMIN_USER=your_admin_user_id

# ═══ Cloudflare ═════════════════════════════════════════════════════════════
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_PROJECT_NAME=lifeos-enterprise
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ═══ KV / R2 / D1 ══════════════════════════════════════════════════════════
LIFEOS_KV_NAMESPACE_ID=your_kv_namespace_id
R2_BUCKET=lifeos-files
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
D1_DATABASE_ID=your_d1_database_id

# ═══ Google OAuth 2.0 ══════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ═══ Microsoft 365 / Outlook ════════════════════════════════════════════════
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# ═══ Apple Sign In ═════════════════════════════════════════════════════════
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key_p8_content

# ═══ Meta / Facebook ═══════════════════════════════════════════════════════
META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret

# ═══ WhatsApp Business API ═════════════════════════════════════════════════
WHATSAPP_APP_ID=your_whatsapp_app_id
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_id

# ═══ Email Delivery ════════════════════════════════════════════════════════
# SMTP tradicional
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@lifeos.app
SMTP_FROM_NAME=LifeOS Enterprise
SMTP_ENCRYPTION=tls
EMAIL_FROM=LifeOS <noreply@lifeos.app>

# Resend (alternativa)
RESEND_API_KEY=your_resend_api_key

# SendGrid (alternativa)
SENDGRID_API_KEY=your_sendgrid_api_key

# ═══ Stripe (Billing) ═══════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_LIFETIME=price_...

# ═══ Mercado Pago (Billing BR) ═════════════════════════════════════════════
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# ═══ OpenAI (AI Orchestration) ════════════════════════════════════════════
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=your_openai_org_id
OPENAI_MODEL=gpt-4o-mini

# ═══ Open Finance Brasil ══════════════════════════════════════════════════
OPENFINANCE_CLIENT_ID=your_openfinance_client_id
OPENFINANCE_CLIENT_SECRET=your_openfinance_client_secret

# ═══ GitHub OAuth ═════════════════════════════════════════════════════════
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ═══ Slack ════════════════════════════════════════════════════════════════
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ═══ Cloudflare Turnstile (CAPTCHA) ═══════════════════════════════════════
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ═══ Push Notifications ═══════════════════════════════════════════════════
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ═══ Analytics ═════════════════════════════════════════════════════════════
GA_MEASUREMENT_ID=G-XXXXXXXXXX
PLAUSIBLE_DOMAIN=lifeos.app

# ═══ Observability ═════════════════════════════════════════════════════════
GRAFANA_PASSWORD=change_me_in_production
LOKI_ENDPOINT=http://localhost:3100
PROMETHEUS_ENDPOINT=http://localhost:9090

# ═══ Backup ════════════════════════════════════════════════════════════════
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
